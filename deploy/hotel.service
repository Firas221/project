# systemd unit — copy to /etc/systemd/system/hotel.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now hotel
[Unit]
Description=Hotel management system
After=network.target

[Service]
User=hotel
Group=hotel
WorkingDirectory=/opt/hotel
EnvironmentFile=/opt/hotel/deploy/hotel.env
Environment=HOTEL_HOST=127.0.0.1 HOTEL_PORT=8000 HOTEL_DB=/var/lib/hotel/hotel.db HOTEL_BACKUP_DIR=/var/lib/hotel/backups
Environment=HOTEL_SEED_DEMO=0 HOTEL_TRUST_PROXY=1 HOTEL_SECURE_COOKIES=1
ExecStart=/usr/bin/python3 /opt/hotel/run.py
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hotel
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target

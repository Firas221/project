# Copy to hotel.env and fill in. Never commit the real file.
HOTEL_PUBLIC_URL=https://booking.your-hotel.com
HOTEL_ALLOWED_ORIGINS=https://booking.your-hotel.com
HOTEL_SMTP_HOST=smtp.your-provider.com
HOTEL_SMTP_PORT=587
HOTEL_SMTP_USER=no-reply@your-hotel.com
HOTEL_SMTP_PASSWORD=change-me
HOTEL_SMTP_FROM=Your Hotel <no-reply@your-hotel.com>
HOTEL_BACKUP_HOURS=24
HOTEL_BACKUP_KEEP=30
